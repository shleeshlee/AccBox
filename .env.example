# ╔══════════════════════════════════════════════════════════════╗
# ║           AccBox 账号管家 - 配置文件                         ║
# ╠══════════════════════════════════════════════════════════════╣
# ║  请复制此文件为 .env 并填入您的配置                          ║
# ║  cp .env.example .env                                        ║
# ╚══════════════════════════════════════════════════════════════╝


# ┌──────────────────────────────────────────────────────────────┐
# │ 端口设置                                                     │
# └──────────────────────────────────────────────────────────────┘
# 默认 9111

PORT=9111


# ┌──────────────────────────────────────────────────────────────┐
# │ 🔐 主密钥 (重要！)                                           │
# └──────────────────────────────────────────────────────────────┘
# 用于加密您的密码数据
# 不设置则使用默认公开密钥，系统会显示安全警告
#
# 生成方法:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

APP_MASTER_KEY=


# ┌──────────────────────────────────────────────────────────────┐
# │ 🎫 JWT 密钥 (可选)                                           │
# └──────────────────────────────────────────────────────────────┘
# 用于登录令牌签名，不设置则自动从 APP_MASTER_KEY 派生
#
# 生成方法:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

JWT_SECRET_KEY=


# ┌──────────────────────────────────────────────────────────────┐
# │ 📦 备份存储配置                                              │
# └──────────────────────────────────────────────────────────────┘
#
# 默认备份保存在 ./backups（AccBox 项目目录下）
# 如需存到其他位置，按以下步骤配置：
#
# 📖 配置步骤（将备份存到外部路径）：
#
#   1. 设置宿主机备份路径（会挂载到容器内 /app/backups）：
#      BACKUP_HOST_PATH=/mnt/backup_disk/accbox
#
#   2. 如果需要更多自定义路径，在 docker-compose.yml 添加挂载：
#      volumes:
#        - /your/external/path:/backup-ext
#
#   3. 将新的容器内路径加入白名单：
#      ALLOWED_BACKUP_PATHS=/app/backups,/app/data,/backup-ext
#
# 注意：ALLOWED_BACKUP_PATHS 里填的是容器内路径，不是宿主机路径。
#       只有白名单内的路径才允许作为备份目标。

# 宿主机备份目录（映射到容器内 /app/backups）
# 示例: BACKUP_HOST_PATH=/mnt/backup_disk/accbox
BACKUP_HOST_PATH=

# 备份路径白名单（容器内路径，逗号分隔）
# 默认: /app/backups,/app/data
ALLOWED_BACKUP_PATHS=/app/backups,/app/data


# ┌──────────────────────────────────────────────────────────────┐
# │ 🔒 Cookie 安全 (可选)                                        │
# └──────────────────────────────────────────────────────────────┘
# 生产环境（HTTPS）保持默认 true
# 纯本地 HTTP 开发设为 false

COOKIE_SECURE=true
